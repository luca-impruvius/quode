# Copy to .env (git-ignored, never commit it) and fill in the values.
# The owner shares them through a password manager, never through chat, email or issues.
# Values: Google Cloud Console > project quode > Google Auth Platform > Clients > "Quode local".
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me

# Google accounts allowed to sign in (comma-separated). Each must also be a test user in
# Google Auth Platform > Audience while the app is in Testing mode.
QUODE_ALLOWED_EMAILS=you@example.com

# Only if port 5432 is already taken on your machine (docs/onboarding.md, section 4): the dev
# database listens on QUODE_DB_PORT instead, and DB_URL points the backend at it.
# QUODE_DB_PORT=55432
# DB_URL=jdbc:postgresql://127.0.0.1:55432/quode
