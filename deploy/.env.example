# Production settings for deploy/compose.yml. On the server: copy to .env next to compose.yml,
# fill in the values from the password manager, then chmod 600 .env. Never commit the real file.

# The site's domain (Caddy gets its certificate for it). For a local run: localhost.
QUODE_DOMAIN=quode.app

# Image tag to run: the git commit the images were built from (see the "Images" workflow).
QUODE_TAG=replace-with-commit-sha

# Database owner, used by the backend and Flyway. Long random password.
DB_USER=quode
DB_PASSWORD=replace-me

# Read-only role for debugging (docs/runbooks/production-debugging.md). Long random password.
QUODE_READONLY_PASSWORD=replace-me

# Google Cloud Console > project quode > Google Auth Platform > Clients > "Quode production".
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me

# Google accounts allowed to sign in (comma-separated).
QUODE_ALLOWED_EMAILS=you@example.com
