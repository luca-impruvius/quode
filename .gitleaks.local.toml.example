# Copy to .gitleaks.local.toml (git-ignored, never commit it) and put YOUR OWN details in it.
# The pre-commit hook runs these rules on top of .gitleaks.toml. Run manual scans from the repo root:
# the path below is relative to the current directory.
title = "quode-local"

[extend]
path = ".gitleaks.toml"

# Uncomment and fill in. Escape dots in regexes (\.).
#
# [[rules]]
# id = "my-email"
# description = "My personal email address"
# regex = '''(?i)firstname\.lastname@example\.com'''
# keywords = ["firstname.lastname"]
#
# [[rules]]
# id = "my-phone"
# description = "My phone number"
# regex = '''\+?40[ -]?7\d{2}[ -]?\d{3}[ -]?\d{3}'''
